---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Footer from '../components/layout/Footer.astro';
import SiteNav from '../components/layout/SiteNav.astro';
import { en } from '../i18n/en';
import { getProfile } from '../lib/content';
import { formatMonth } from '../lib/format/dates';
import { absoluteUrl, canonicalPath, serialiseJsonLd } from '../lib/seo/meta';

interface Props {
  title?: string;
  /** Meta description: one or two sentences, from content/ or en.ts. */
  description: string;
  current?: string;
  /** Keep the page out of search results (404). */
  noindex?: boolean;
  /** Structured data for this page (schema.org), if any. */
  jsonLd?: Record<string, unknown>;
}
const {
  title = en.siteName,
  description,
  current = '',
  noindex = false,
  jsonLd,
} = Astro.props;
const profile = await getProfile();
// Absolute URLs need the site URL (decision O1); without it these tags are left out.
const canonical = noindex
  ? null
  : absoluteUrl(canonicalPath(Astro.url.pathname), Astro.site);
const ogImage = absoluteUrl(en.meta.ogImage, Astro.site);
const ogImageAlt = en.meta.ogImageAlt(
  profile.name,
  profile.seeking.role,
  formatMonth(profile.seeking.start),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={en.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta
      name="twitter:card"
      content={ogImage ? 'summary_large_image' : 'summary'}
    />
    <link rel="sitemap" href="/sitemap.xml" />
    {jsonLd && (
      <script type="application/ld+json" set:html={serialiseJsonLd(jsonLd)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {en.skipLink}
    </a>
    <SiteNav
      brand={`HAMZA-${profile.modelVersion.toUpperCase()}`}
      current={current}
    />
    <main id="main">
      <slot />
    </main>
    <Footer
      name={profile.name}
      github={profile.links.github}
      linkedin={profile.links.linkedin}
    />
  </body>
</html>
