---
import { en } from '../../i18n/en';
import type { ProjectCardView } from '../../lib/content/views';
import Chip from '../ui/Chip.astro';

interface Props {
  project: ProjectCardView;
}
const { project } = Astro.props;
const t = en.projectsPage;
const frame = [
  project.context && t.context(project.context),
  project.client && t.client(project.client),
]
  .filter(Boolean)
  .join(' · ');
const when = [project.year, project.current && t.inProgress]
  .filter(Boolean)
  .join(' · ');
// The logo sits small next to the title; it is omitted when the project has none.
---

<a class="card" href={project.href}>
  {(project.topic || when) && (
    <span class="meta">
      {project.topic && <Chip variant="accent">{project.topic}</Chip>}
      {when && <span class="year">{when}</span>}
    </span>
  )}
  <span class="head">
    {project.image && (
      <span class="logo">
        <img
          src={project.image.src}
          alt={project.image.alt}
          loading="lazy"
          decoding="async"
        />
      </span>
    )}
    <h2 class="title">{project.title}</h2>
  </span>
  {frame && <p class="frame">{frame}</p>}
  <p class="summary">{project.summary}</p>
  {project.stack.length > 0 && <p class="stack">{project.stack.join(' · ')}</p>}
  <span class="open">{t.open}</span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-4);
    background: var(--color-surface);
    border: var(--border-thick);
    text-decoration: none;
    transition:
      background var(--transition-fast),
      color var(--transition-fast);
  }

  .card:hover {
    background: var(--color-ink);
    color: var(--color-on-ink);
  }

  .head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* A small white tile keeps every logo legible, also on the inverted hover card. */
  .logo {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    height: 3.25rem;
    min-width: 3.25rem;
    max-width: 7.5rem;
    padding: var(--space-1) var(--space-2);
    background: var(--color-surface);
    border: var(--border-thin);
  }

  /* Fixed height, free width: wide wordmarks stay readable, square marks stay small. */
  .logo img {
    width: auto;
    max-width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: var(--text-label-small);
  }

  /* The chip keeps ink text on lime when the card is inverted. */
  .card:hover .meta :global(.chip) {
    color: var(--color-ink);
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--text-card-title);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: normal;
  }

  .frame {
    font-size: var(--text-label);
    font-weight: 700;
  }

  .summary {
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .stack {
    font-size: var(--text-label);
    color: var(--color-muted);
  }

  .card:hover .stack {
    color: var(--color-on-ink-muted);
  }

  .open {
    margin-top: auto;
    padding-top: var(--space-1);
    font-size: 0.875rem;
    font-weight: 700;
  }

  @media (min-width: 48em) {
    .card {
      padding: 1.375rem;
    }
  }
</style>
