---
import { en } from '../../i18n/en';
import type { ProjectCardView } from '../../lib/content/views';
import Chip from '../ui/Chip.astro';

interface Props {
  project: ProjectCardView;
}
const { project } = Astro.props;
const t = en.projectsPage;
const frame = [
  project.context && t.context(project.context),
  project.client && t.client(project.client),
]
  .filter(Boolean)
  .join(' · ');
const when = [project.year, project.current && t.inProgress]
  .filter(Boolean)
  .join(' · ');
// The image area is omitted when the project has no image (design-spec: no empty blocks).
---

<a class="card" href={project.href}>
  {project.image && (
    <span class="media">
      <img
        src={project.image.src}
        alt={project.image.alt}
        loading="lazy"
        decoding="async"
      />
    </span>
  )}
  {(project.topic || when) && (
    <span class="meta">
      {project.topic && <Chip variant="accent">{project.topic}</Chip>}
      {when && <span class="year">{when}</span>}
    </span>
  )}
  <h2 class="title">{project.title}</h2>
  {frame && <p class="frame">{frame}</p>}
  <p class="summary">{project.summary}</p>
  {project.stack.length > 0 && <p class="stack">{project.stack.join(' · ')}</p>}
  <span class="open">{t.open}</span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-4);
    background: var(--color-surface);
    border: var(--border-thick);
    text-decoration: none;
    transition:
      background var(--transition-fast),
      color var(--transition-fast);
  }

  .card:hover {
    background: var(--color-ink);
    color: var(--color-on-ink);
  }

  .media {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 11.25rem; /* 180px, as in the mockup */
    margin: calc(-1 * var(--space-4)) calc(-1 * var(--space-4)) var(--space-1);
    padding: var(--space-6);
    background: var(--color-surface);
    border-bottom: var(--border-thick);
  }

  /* Caps the width so wide wordmarks do not outweigh tall logos. */
  .media img {
    max-width: min(100%, 13rem);
    max-height: 100%;
    object-fit: contain;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: var(--text-label-small);
  }

  /* The chip keeps ink text on lime when the card is inverted. */
  .card:hover .meta :global(.chip) {
    color: var(--color-ink);
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--text-card-title);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: normal;
  }

  .frame {
    font-size: var(--text-label);
    font-weight: 700;
  }

  .summary {
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .stack {
    font-size: var(--text-label);
    color: var(--color-muted);
  }

  .card:hover .stack {
    color: var(--color-on-ink-muted);
  }

  .open {
    margin-top: auto;
    padding-top: var(--space-1);
    font-size: 0.875rem;
    font-weight: 700;
  }

  @media (min-width: 48em) {
    .card {
      padding: 1.375rem;
    }

    .media {
      margin: -1.375rem -1.375rem var(--space-1);
    }
  }
</style>
