---
interface Props {
  label: string;
  /** "title": short value in the display font (model details); "text": a sentence in body text. */
  size?: 'title' | 'text';
}
const { label, size = 'title' } = Astro.props;
---

<div class:list={['cell', `cell--${size}`]}>
  <dt>{label}</dt>
  <dd>
    <slot />
  </dd>
</div>

<style>
  .cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4);
    background: var(--color-surface);
  }

  dt {
    font-size: var(--text-label-small);
    color: var(--color-muted);
  }

  dd {
    margin: 0;
  }

  .cell--title dd {
    font-family: var(--font-display);
    font-size: var(--text-card-title);
    font-weight: 700;
  }

  .cell--text dd {
    font-size: clamp(0.875rem, 0.8rem + 0.25vw, 1rem);
    line-height: 1.6;
  }

  @media (min-width: 48em) {
    .cell {
      padding: var(--space-6) var(--space-5);
    }
  }
</style>
