---
import { lossCurve } from '../../lib/charts/loss-curve';

interface Props {
  count: number;
  label: string;
  /** Drawing heights (viewBox units) for desktop and phone. */
  desktopHeight?: number;
  phoneHeight?: number;
  /** Draws a baseline under the curve. */
  axis?: boolean;
  /** Index of the highlighted marker, if any. */
  active?: number;
}
const {
  count,
  label,
  desktopHeight = 200,
  phoneHeight = 90,
  axis = false,
  active,
} = Astro.props;

// Two drawings (phone and desktop) so markers keep a readable size; only one is shown at a time.
const axisGap = axis ? 15 : 0;
const desktop = lossCurve(count, 1280, desktopHeight - axisGap, 10);
const phone = lossCurve(count, 350, phoneHeight - axisGap, 6);
---

<svg
  class="curve curve--desktop"
  viewBox={`0 0 1280 ${desktopHeight}`}
  role="img"
  aria-label={label}
>
  <path
    class="line"
    d={desktop.path}
    pathLength="1"
    fill="none"
    stroke="currentColor"
    stroke-width="4"
  ></path>
  {axis && (
    <line
      class="baseline"
      x1="10"
      y1={desktopHeight - 5}
      x2="1270"
      y2={desktopHeight - 5}
    />
  )}
  {desktop.points.map((p, i) => (
    <circle
      class:list={['marker', { 'is-active': i === active }]}
      data-step={i}
      cx={p.x}
      cy={p.y}
      r="11"
    />
  ))}
</svg>
<svg
  class="curve curve--phone"
  viewBox={`0 0 350 ${phoneHeight}`}
  role="img"
  aria-label={label}
>
  <path
    class="line"
    d={phone.path}
    pathLength="1"
    fill="none"
    stroke="currentColor"
    stroke-width="3"
  ></path>
  {axis && (
    <line
      class="baseline"
      x1="6"
      y1={phoneHeight - 4}
      x2="344"
      y2={phoneHeight - 4}
    />
  )}
  {phone.points.map((p, i) => (
    <circle
      class:list={['marker', { 'is-active': i === active }]}
      data-step={i}
      cx={p.x}
      cy={p.y}
      r="7"
    />
  ))}
</svg>

<style>
  .curve {
    width: 100%;
    height: auto;
    /* End markers sit on the edge of the drawing. */
    overflow: visible;
    color: var(--color-accent);
  }

  /* Markers are filled; when one is highlighted, the others become rings. */
  .marker {
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 4;
  }

  .curve:has(.is-active) .marker:not(.is-active) {
    fill: var(--color-ink);
  }

  .baseline {
    stroke: var(--color-muted);
    stroke-width: 2;
  }

  .curve--desktop {
    display: none;
  }

  @media (min-width: 48em) {
    .curve--desktop {
      display: block;
    }

    .curve--phone {
      display: none;
    }
  }
</style>
