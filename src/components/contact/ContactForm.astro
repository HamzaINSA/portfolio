---
import { en } from '../../i18n/en';

interface Props {
  to: string;
}
const { to } = Astro.props;
const t = en.aboutPage.contact.form;
// Without JavaScript the browser posts the form to the mail client (mailto action).
// With JavaScript the script builds a cleaner mailto: link with a subject and a signed body.
// Either way nothing is sent to a server and nothing is stored (decision D9).
---

<form
  class="form"
  action={`mailto:${to}`}
  method="post"
  enctype="text/plain"
  aria-label={t.label}
  data-contact-form
  data-to={to}
>
  <div class="field">
    <label for="contact-name">{t.name}</label>
    <input
      id="contact-name"
      name="name"
      type="text"
      autocomplete="name"
      required
    />
  </div>
  <div class="field">
    <label for="contact-email">{t.email}</label>
    <input
      id="contact-email"
      name="email"
      type="email"
      autocomplete="email"
      required
    />
  </div>
  <div class="field">
    <label for="contact-message">{t.message}</label>
    <textarea id="contact-message" name="message" rows="5" required></textarea>
  </div>
  <button type="submit" class="send">
    {t.send}
  </button>
  <p class="note">{t.note}</p>
</form>

<script>
  import { en } from '../../i18n/en';
  import { buildMailto } from '../../lib/contact/mailto';

  for (const form of document.querySelectorAll<HTMLFormElement>(
    '[data-contact-form]',
  )) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const value = (key: string) => String(data.get(key) ?? '');
      window.location.href = buildMailto(
        form.dataset.to ?? '',
        {
          name: value('name'),
          email: value('email'),
          message: value('message'),
        },
        en.aboutPage.contact.form.subject,
      );
    });
  }
</script>

<style>
  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-surface);
    border: var(--border-thick);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  label {
    font-size: var(--text-label);
    font-weight: 700;
  }

  input,
  textarea {
    min-height: var(--button-min-height);
    padding: var(--space-3);
    background: var(--color-paper);
    color: var(--color-ink);
    border: var(--border-thin);
    border-radius: var(--radius);
    font: inherit;
    font-size: 0.9375rem;
  }

  textarea {
    resize: vertical;
  }

  .send {
    min-height: calc(var(--button-min-height) + var(--space-1));
    background: var(--color-accent);
    color: var(--color-ink);
    border: var(--border-thick);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 700;
    cursor: pointer;
    transition:
      background var(--transition-fast),
      color var(--transition-fast);
  }

  .send:hover {
    background: var(--color-ink);
    color: var(--color-on-ink);
  }

  .note {
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--color-muted-strong);
  }

  @media (min-width: 48em) {
    .form {
      padding: 1.75rem;
    }
  }
</style>
