---
import { en } from '../../i18n/en';
import LossCurve from '../charts/LossCurve.astro';
import Container from '../layout/Container.astro';

interface Props {
  checkpoints: { title: string; organization: string }[];
  now: string;
  trainingHref: string;
}
const { checkpoints, now, trainingHref } = Astro.props;
const total = checkpoints.length + 1;
---

<section class="training on-ink" aria-labelledby="training-title">
  <Container class="training-inner">
    <div class="head">
      <h2 id="training-title">{en.training.title}</h2>
      <a class="all" href={trainingHref}>
        {en.training.all}
      </a>
    </div>
    <LossCurve count={total} label={en.training.curveLabel} />
    <ol class="checkpoints">
      {checkpoints.map((c, i) => (
        <li>
          <p class="label">
            {en.training.checkpoint} {i + 1}
          </p>
          <p class="title">{c.title}</p>
          <p class="org">{c.organization}</p>
        </li>
      ))}
      <li>
        <p class="label">{`${en.training.checkpoint} ${total} · ${en.training.now}`}</p>
        <p class="title">{now}</p>
      </li>
    </ol>
  </Container>
</section>

<style>
  .training {
    background: var(--color-ink);
    color: var(--color-on-ink);
    border-top: var(--border-thick);
  }

  .training :global(.training-inner) {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-block: clamp(2.25rem, 1rem + 4vw, 4.5rem);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
  }

  h2 {
    font-size: var(--text-section-title);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .all {
    display: flex;
    align-items: center;
    min-height: var(--target-min);
    color: var(--color-accent);
    font-weight: 700;
  }

  .checkpoints {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: var(--space-5) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding-top: var(--space-3);
    border-top: 2px solid var(--color-accent);
  }

  .label {
    font-size: var(--text-label-small);
    color: var(--color-accent);
  }

  .title {
    margin-top: var(--space-1);
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.25rem);
    font-weight: 700;
  }

  .org {
    margin-top: var(--space-1);
    font-size: var(--text-label);
    color: var(--color-on-ink-muted);
  }

  @media (min-width: 48em) {
    .training :global(.training-inner) {
      gap: var(--space-8);
    }
  }
</style>
