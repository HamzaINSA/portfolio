---
import { homeDescription, personJsonLd } from '../lib/seo/meta';
import ConsoleTeaser from '../components/sections/ConsoleTeaser.astro';
import EvaluationPreview from '../components/sections/EvaluationPreview.astro';
import Hero from '../components/sections/Hero.astro';
import LogoStrip from '../components/sections/LogoStrip.astro';
import ModelDetails from '../components/sections/ModelDetails.astro';
import TrainingPreview from '../components/sections/TrainingPreview.astro';
import Container from '../components/layout/Container.astro';
import CtaStrip from '../components/ui/CtaStrip.astro';
import { en, teaserSuggestionIds } from '../i18n/en';
import {
  getEducation,
  getExperiences,
  getKnowledgeBase,
  getPartners,
  getProfile,
  getProjects,
} from '../lib/content';
import {
  checkpoints,
  currentEducation,
  entriesById,
  featuredProjects,
} from '../lib/content/select';
import { formatMonth } from '../lib/format/dates';
import { isPublishable } from '../lib/content/gate';
import { bioParagraphs, toCheckpointView } from '../lib/content/views';
import BaseLayout from '../layouts/BaseLayout.astro';

const [profile, education, experiences, projects, knowledgeBase, partnersFile] =
  await Promise.all([
    getProfile(),
    getEducation(),
    getExperiences(),
    getProjects(),
    getKnowledgeBase(),
    getPartners(),
  ]);
const partners = isPublishable(partnersFile) ? partnersFile.partners : [];

const firstName = (profile.name.split(' ')[0] ?? profile.name).toLowerCase();
// "4th year" -> "4th-year" so that it reads as an adjective in the intro.
const intro = `${profile.yearLabel.replace(/\s+/g, '-')} ${profile.school} engineering student, ${en.hero.introSuffix}`;
const period = `${formatMonth(profile.seeking.start)} · ${profile.seeking.duration}`;

const suggestions = entriesById(knowledgeBase, teaserSuggestionIds).map(
  (entry) => ({
    label: entry.suggestedLabel ?? entry.title,
    href: `/ask?q=${encodeURIComponent(entry.suggestedLabel ?? entry.title)}`,
  }),
);

const steps = checkpoints(experiences).map(toCheckpointView);
const education_ = currentEducation(education);
const now = `${profile.school}, ${profile.yearLabel}`;

const cards = featuredProjects(projects).map((p) => ({
  title: p.title,
  summary: p.summary,
  href: `/projects/${p.id}`,
}));
---

<BaseLayout
  current="home"
  description={homeDescription(profile)}
  jsonLd={personJsonLd(profile, Astro.site)}
>
  <Container class="hero">
    <Hero
      firstName={firstName}
      version={profile.modelVersion}
      period={period}
      intro={intro}
    />
    <ConsoleTeaser suggestions={suggestions} />
  </Container>

  {partners.length > 0 && <LogoStrip partners={partners} />}

  <ModelDetails
    version={`${profile.modelVersion}, ${profile.school} ${profile.yearLabel}`}
    architecture={education_?.program ?? null}
    intendedUse={profile.seeking.role}
    bio={bioParagraphs(profile.bio)[0] ?? null}
    aboutHref="/about"
  />

  <TrainingPreview
    checkpoints={steps}
    now={now}
    next={en.training.next(
      profile.seeking.role,
      formatMonth(profile.seeking.start),
    )}
    trainingHref="/training"
  />

  {cards.length > 0 && (
    <EvaluationPreview projects={cards} allHref="/projects" />
  )}

  <CtaStrip
    title={en.cta.title}
    primary={{ label: en.cta.contact, href: '/about#contact' }}
    secondary={{ label: en.cta.ask, href: en.nav.cta.href }}
  />
</BaseLayout>

<style>
  :global(.hero) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(30rem, 100%), 1fr));
    align-items: center;
    gap: var(--space-10);
    padding-block: var(--space-8) var(--space-8);
  }

  @media (min-width: 48em) {
    :global(.hero) {
      gap: var(--space-14);
      padding-block: 4rem 3.5rem;
    }
  }

  /* Wider text column so that "hamza" and the version chip stay on one line at the design width. */
  @media (min-width: 75em) {
    :global(.hero) {
      grid-template-columns: 1.15fr 1fr;
    }
  }
</style>
