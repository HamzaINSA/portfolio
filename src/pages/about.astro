---
import ReleaseNotes from '../components/about/ReleaseNotes.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import Container from '../components/layout/Container.astro';
import Button from '../components/ui/Button.astro';
import { en } from '../i18n/en';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProfile, getReleases, getSkills } from '../lib/content';
import {
  capabilityGroups,
  releaseNotes,
  versionNumber,
} from '../lib/content/views';
import { formatMonth } from '../lib/format/dates';

const [profile, skills, releasesFile] = await Promise.all([
  getProfile(),
  getSkills(),
  getReleases(),
]);
const t = en.aboutPage;

const releases = releaseNotes(releasesFile);
const objective =
  releasesFile.status === 'verified' ? releasesFile.objective : null;
const seeking = profile.seeking;
const intendedUse = [
  seeking.role,
  formatMonth(seeking.start),
  seeking.duration,
  seeking.relocation ? t.relocation : null,
]
  .filter(Boolean)
  .join(' · ');

const capabilities = capabilityGroups(skills, t.spoken);
const email = profile.contact.email;
---

<BaseLayout
  title={`${t.title} · ${en.siteName}`}
  description={en.meta.about}
  current="about"
>
  <Container class="intro">
    <div class="intro-text">
      <p class="crumb">{t.crumb}</p>
      <h1>{t.title}</h1>
      <div class="term" role="group" aria-label={t.terminal.label}>
        <p>
          <span class="prompt" aria-hidden="true">
            $
          </span>
          {t.terminal.binary} {t.terminal.version}
        </p>
        <p>
          {t.terminal.binary} {versionNumber(profile.modelVersion)}
          <span class="comment">
            # {profile.yearLabel}, {profile.headline}, {profile.school}
          </span>
        </p>
        {objective && (
          <>
            <p>
              <span class="prompt" aria-hidden="true">
                $
              </span>
              {t.terminal.binary} {t.terminal.objective}
            </p>
            <p>
              {objective}
              {releasesFile.objectiveComment && (
                <span class="comment"># {releasesFile.objectiveComment}</span>
              )}
            </p>
          </>
        )}
        <p>
          <span class="prompt" aria-hidden="true">
            $
          </span>
          {t.terminal.binary} {t.terminal.deploy}
          <span class="cursor" aria-hidden="true"></span>
        </p>
      </div>
    </div>
    {profile.photo && (
      <div class="photo">
        <img
          src={profile.photo}
          alt={t.photoAlt}
          width="800"
          height="1000"
          decoding="async"
        />
      </div>
    )}
  </Container>

  {releases.length > 0 && (
    <Container>
      <ReleaseNotes releases={releases} />
    </Container>
  )}

  {capabilities.length > 0 && (
    <section class="capabilities on-ink" aria-labelledby="capabilities-title">
      <Container class="capabilities-inner">
        <h2 id="capabilities-title">{t.capabilities}</h2>
        <div class="groups">
          {capabilities.map((group) => (
            <div class="group">
              <h3>{group.label}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </Container>
    </section>
  )}

  <section class="deploy" aria-labelledby="deploy-title">
    <Container class="deploy-inner">
      <div>
        <h2 id="deploy-title" class="visually-hidden">
          {t.deploy.label}
        </h2>
        <p class="deploy-command">
          <code>{t.deploy.command(seeking.start)}</code>
        </p>
        <p class="deploy-text">{intendedUse}</p>
      </div>
      <Button href="#contact">{t.deploy.cta}</Button>
    </Container>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-title">
    <Container class="contact-inner">
      <div class="contact-main">
        <h2 id="contact-title">
          {t.contact.title[0]}
          <br />
          {t.contact.title[1]}
        </h2>
        {email && <Button href={`mailto:${email}`}>{email}</Button>}
        <div class="contact-links">
          <Button href={profile.links.linkedin} variant="secondary">
            {t.contact.linkedin}
          </Button>
          <Button href={profile.links.github} variant="secondary">
            {t.contact.github}
          </Button>
        </div>
      </div>
      {email && <ContactForm to={email} />}
    </Container>
  </section>
</BaseLayout>

<style>
  :global(.intro) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(26.25rem, 100%), 1fr));
    gap: var(--space-10);
    align-items: start;
    padding-block: var(--space-10) var(--space-8);
  }

  .crumb {
    margin-bottom: var(--space-4);
    font-size: var(--text-label);
  }

  h1 {
    font-size: clamp(3.5rem, 2rem + 5.5vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .term {
    max-width: 47.5rem;
    margin-top: var(--space-6);
    padding: var(--space-5) var(--space-6);
    background: var(--color-ink);
    color: var(--color-on-ink);
    border: var(--border-thick);
    box-shadow: var(--shadow-offset-small);
    font-size: clamp(0.8125rem, 0.75rem + 0.3vw, 0.9375rem);
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  .prompt {
    margin-right: var(--space-2);
    color: var(--color-accent);
  }

  .comment {
    margin-left: var(--space-2);
    color: var(--color-on-ink-muted);
  }

  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: var(--space-1);
    vertical-align: text-bottom;
    background: var(--color-accent);
    animation: blink 1s steps(2, start) infinite;
  }

  @keyframes blink {
    to {
      visibility: hidden;
    }
  }

  /* Leaves room on the right for the offset shadow. */
  .photo {
    justify-self: center;
    width: min(100% - 10px, 26rem);
    border: var(--border-thick);
    box-shadow: var(--shadow-offset-small);
  }

  .photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .capabilities {
    background: var(--color-ink);
    color: var(--color-on-ink);
    border-block: var(--border-thick);
  }

  .capabilities :global(.capabilities-inner) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18.75rem, 100%), 1fr));
    gap: var(--space-8);
    padding-block: var(--section-pad);
  }

  .capabilities h2 {
    font-size: clamp(2.25rem, 1.6rem + 2vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
    gap: var(--space-6);
  }

  @media (min-width: 64em) {
    .groups {
      grid-column: span 2;
    }
  }

  .group h3 {
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-label-small);
    font-weight: 400;
    letter-spacing: normal;
    color: var(--color-accent);
  }

  .group ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    line-height: 1.8;
  }

  .deploy {
    background: var(--color-accent);
    border-bottom: var(--border-thick);
  }

  .deploy :global(.deploy-inner) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-10);
  }

  .deploy-command {
    font-size: clamp(1rem, 0.75rem + 1.1vw, 1.625rem);
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .deploy-text {
    margin-top: var(--space-2);
    font-size: var(--text-label);
  }

  .contact :global(.contact-inner) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(26.25rem, 100%), 1fr));
    gap: var(--space-10);
    padding-block: var(--section-pad);
  }

  .contact-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    min-width: 0;
  }

  .contact h2 {
    font-size: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  /* Long email addresses must wrap on narrow phones. */
  .contact-main :global(.btn) {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Large screens: the terminal column takes the room, the photo stays a fixed size. */
  @media (min-width: 64em) {
    :global(.intro) {
      grid-template-columns: 1fr 22rem;
    }
  }

  @media (min-width: 48em) {
    .photo {
      justify-self: end;
      box-shadow: var(--shadow-offset);
    }
  }
</style>
